    <profiles>
        <!-- Drools 5.5's MVEL references java.lang.Compiler, which was removed in JDK 21.
             On JDK 21+, compile an empty stub of it and patch it into java.base for tests. -->
        <profile>
            <id>jdk21-plus</id>
            <activation>
                <jdk>[21,)</jdk>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>compile-jdk-patch</id>
                                <phase>process-test-classes</phase>
                                <goals>
                                    <goal>compile</goal>
                                </goals>
                                <configuration>
                                    <release>21</release>
                                    <compileSourceRoots>
                                        <compileSourceRoot>${project.basedir}/src/jdk-patch</compileSourceRoot>
                                    </compileSourceRoots>
                                    <outputDirectory>${project.build.directory}/jdk-patch</outputDirectory>
                                    <compilerArgs>
                                        <arg>--patch-module</arg>
                                        <arg>java.base=${project.basedir}/src/jdk-patch</arg>
                                    </compilerArgs>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <argLine>--patch-module java.base=${project.build.directory}/jdk-patch --add-opens java.base/java.lang=ALL-UNNAMED</argLine>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
